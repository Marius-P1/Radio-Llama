# API keys

# Mistral API key, used when LLM_PROVIDER is "mistral". No default.
MISTRAL_API_KEY=
# Anthropic API key, used when LLM_PROVIDER is "anthropic". No default.
ANTHROPIC_API_KEY=
# ElevenLabs API key, used when TTS_BACKEND is "elevenlabs". No default.
ELEVENLABS_API_KEY=

# Radio settings

# Language of the show: "en" or "fr". Default: en.
RADIO_LANGUAGE=
# LLM provider: "mistral", "anthropic" or "fake". Default: mistral.
LLM_PROVIDER=
# Model name passed to the LLM provider. Default: mistral-small-latest.
LLM_MODEL=
# Text-to-speech backend: "elevenlabs" or "fake". Default: elevenlabs.
TTS_BACKEND=

# Paths

# Folder for cached TTS audio. Default: cache.
CACHE_DIR=
# Folder where generated shows are written. Default: output.
OUTPUT_DIR=
# Path to the track catalog. Default: catalog/catalog.json.
CATALOG_PATH=
# Folder holding the prompt files, one subfolder per language. Default: prompts.
PROMPTS_DIR=
