# API keys

# Mistral API key, used when LLM_PROVIDER is "mistral". No default.
MISTRAL_API_KEY=
# Anthropic API key, used when LLM_PROVIDER is "anthropic". No default.
ANTHROPIC_API_KEY=
# ElevenLabs API key, used when TTS_BACKEND is "elevenlabs". No default.
ELEVENLABS_API_KEY=
# Jamendo client id from devportal.jamendo.com. Enables the Jamendo music source. No default.
JAMENDO_CLIENT_ID=
# YouTube Data API v3 key from a Google Cloud project. Enables the YouTube music source. No default.
YOUTUBE_API_KEY=

# Radio settings

# Two-letter country code for YouTube searches and region checks. Default: FR.
YOUTUBE_REGION=
# Language of the show: "en" or "fr". Default: en.
RADIO_LANGUAGE=
# Timezone the host greets by, an IANA name such as Europe/Paris. Default: the machine's
# local time, which is UTC inside Docker.
RADIO_TIMEZONE=
# LLM provider: "mistral", "anthropic" or "fake". Default: mistral.
LLM_PROVIDER=
# Model name passed to the LLM provider. Default: mistral-small-latest.
LLM_MODEL=
# Text-to-speech backend: "elevenlabs" or "fake". Default: elevenlabs.
TTS_BACKEND=
# ElevenLabs model id used for every voice. Default: eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=
# The most songs an endless show plays before the host closes it by itself. It bounds what
# a show left running can spend. 0 means no limit. Default: 100.
ENDLESS_MAX_SONGS=

# Paths

# Folder for cached TTS audio. Default: cache.
CACHE_DIR=
# Folder where generated shows are written. Default: output.
OUTPUT_DIR=
# Path to the track catalog. Default: catalog/catalog.json.
CATALOG_PATH=
# Folder holding the prompt files, one subfolder per language. Default: prompts.
PROMPTS_DIR=
# Built frontend, served at / when the folder exists. Default: frontend/dist.
FRONTEND_DIST=
