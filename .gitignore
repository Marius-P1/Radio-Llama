# Working notes for the rebuild stay on disk, never in git (Marius's choice).
docs/
# The agent kit (handover, per-ticket work files) stays local too.
.claude/agent-kit/
# Agent instructions stay local; contributors read CONTRIBUTING.md.
CLAUDE.md
AGENTS.md

# Secrets and local environment
.env
.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Generated at runtime
cache/
output/
catalog/audio/
# Test tones for the fixture catalog, generated by its make_placeholder_audio.py
tests/fixtures/catalog/audio/

# Audio is never committed
*.mp3
*.wav
# Exported replay shows hold MP3s and ship as a release asset
frontend/public/shows/

# Frontend
node_modules/
frontend/dist/

# Python build artifacts
dist/
*.egg-info/

# Screenshots and traces left by the Playwright MCP server
.playwright-mcp/
