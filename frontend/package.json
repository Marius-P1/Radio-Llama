{
  "name": "radio-llama-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:replay": "tsc -b && vite build --mode replay",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate-types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  }
}
