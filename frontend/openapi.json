    "/api/v1/shows/{show_id}/end": {
      "post": {
        "description": "Close an endless show after the song at segment `after`, and return the show (D044).\n\nThe part made past that song, one break and one song at most, is dropped and the\nhost's goodbye takes its place. A show that is already closed is returned as it is.\n\nThe errors are those of `next_part`. The 409 also covers an `after` that is not a\nsong of the show, and an `after` with more than one song behind it: the player is\nnever more than one part ahead, and this request never deletes more than that.",
        "operationId": "end_show_api_v1_shows__show_id__end_post",
        "parameters": [
          {
            "in": "path",
            "name": "show_id",
            "required": true,
            "schema": {
              "title": "Show Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndShowRequest"
              }
            }
          },
          "required": true
        },
